{
 "title": "Overview",
 "database": {
  "url": "sqlite:///:memory:"
 },
 "interval": "10m",
 "show_countdown": true,
 "countdown_format": "all in {clock}",
 "args": [
  {
   "name": "hours",
   "type": "int",
   "default": 24,
   "description": "Hours of history"
  }
 ],
 "show": {
  "interval": "60s",
  "show_countdown": true,
  "countdown_format": "{time}s",
  "args_show": true
 },
 "layout": {
  "columns": 2,
  "gap": 3
 },
 "panels": [
  {
   "query": {
    "sql": "WITH RECURSIVE h(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM h WHERE n < {{ args.hours }} - 1)\nSELECT printf('%02d:00', n % 24) AS hour,\n       50 + abs(random() % 100) AS visits\nFROM h\n"
   },
   "show": {
    "type": "line",
    "title": "Visits per hour",
    "x_column": "hour",
    "y_column": "visits",
    "interval": "10s",
    "span": 2
   }
  },
  {
   "query": {
    "sql": "SELECT 'IT' AS dept, 42 AS people UNION ALL SELECT 'HR', 7\nUNION ALL SELECT 'Finance', 15 UNION ALL SELECT 'R&D', 120\n"
   },
   "show": {
    "type": "pie",
    "renderer": "circle",
    "title": "Headcount",
    "label_column": "dept",
    "value_column": "people"
   }
  },
  {
   "query": {
    "sql": "SELECT datetime('now') AS now, abs(random() % 1000) AS orders\n"
   },
   "show": {
    "type": "table",
    "title": "Now"
   }
  },
  {
   "database": {
    "url": "sqlite:///:memory:"
   },
   "query": {
    "sql": "SELECT abs(random() % 5000) AS orders\n"
   },
   "show": {
    "type": "stat",
    "title": "Orders today",
    "format": "{:,}",
    "interval": "10s"
   }
  },
  {
   "database": {
    "url": "https://api.github.com"
   },
   "query": {
    "sql": "{\n  \"path\": \"/repos/neovim/neovim/contributors\",\n  \"query\": {\"per_page\": 8},\n  \"headers\": {\"Accept\": \"application/vnd.github+json\"}\n}\n"
   },
   "show": {
    "type": "bar",
    "title": "Top Neovim contributors",
    "x_column": "login",
    "y_column": "contributions",
    "span": 2,
    "interval": "10m",
    "style": {
     "show_values": true
    }
   }
  }
 ]
}
