{
 "database": {
  "url": "sqlite:///:memory:"
 },
 "interval": "60s",
 "args": [
  {
   "name": "hours",
   "type": "int",
   "default": 24,
   "description": "Hours of history"
  }
 ],
 "layout": {
  "columns": 2,
  "gap": 3
 },
 "panels": [
  {
   "query": {
    "sql": "WITH RECURSIVE h(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM h WHERE n < {{ hours }} - 1)\nSELECT printf('%02d:00', n % 24) AS hour,\n       50 + abs(random() % 100) AS visits\nFROM h\n"
   },
   "show": {
    "type": "line",
    "title": "Visits per hour",
    "x_column": "hour",
    "y_column": "visits",
    "interval": "10s",
    "span": 2,
    "show_countdown": true,
    "countdown_format": "{time}s"
   }
  },
  {
   "query": {
    "sql": "SELECT 'IT' AS dept, 42 AS people UNION ALL SELECT 'HR', 7\nUNION ALL SELECT 'Finance', 15 UNION ALL SELECT 'R&D', 120\n"
   },
   "show": {
    "type": "pie",
    "renderer": "circle",
    "title": "Headcount",
    "label_column": "dept",
    "value_column": "people"
   }
  },
  {
   "query": {
    "sql": "SELECT datetime('now') AS now, abs(random() % 1000) AS orders\n"
   },
   "show": {
    "type": "table",
    "title": "Now",
    "show_countdown": true,
    "countdown_format": "{time}s"
   }
  },
  {
   "query": {
    "sql": "SELECT abs(random() % 5000) AS orders\n"
   },
   "show": {
    "type": "stat",
    "title": "Orders today",
    "format": "{:,}",
    "interval": "10s"
   }
  }
 ]
}
