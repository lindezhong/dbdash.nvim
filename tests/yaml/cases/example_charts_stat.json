{
 "database": {
  "url": "sqlite:///:memory:"
 },
 "query": {
  "sql": "SELECT 'active' AS label, 900 + abs(random() % 300) AS users\n"
 },
 "show": {
  "type": "stat",
  "title": "Active users",
  "value_column": "users",
  "format": "{:,}",
  "unit": "users",
  "interval": "5s",
  "thresholds": [
   {
    "value": 1000,
    "color": "yellow"
   },
   {
    "value": 1190,
    "color": "red",
    "notify": true
   }
  ]
 }
}
